new file mode 100644
index 000000000..e3ab7cac4
--- /dev/null
+++ b/tools/testing/selftests/riscv/vector/v_owner_context.c
@@ -0,0 +1,326 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <sched.h>
+#include <signal.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "../../kselftest.h"
+
+#define VECTOR_ROUNDS 32
+#define BUSY_LOOPS 20000000UL
+#define MIGRATION_LOOPS 200000000UL
+
+struct vector_worker_args {
+	int cpu;
+	uint8_t seed;
+	unsigned int rounds;
+	unsigned long loops;
+	pthread_barrier_t *barrier;
+	atomic_int *failures;
+};
+
+struct noise_worker_args {
+	int cpu;
+	pthread_barrier_t *barrier;
+	atomic_bool *stop;
+	atomic_int *failures;
+};
+
+static volatile sig_atomic_t signal_seen;
+
+static int pin_current_thread(int cpu)
+{
+	cpu_set_t set;
+
+	CPU_ZERO(&set);
+	CPU_SET(cpu, &set);
+	return pthread_setaffinity_np(pthread_self(), sizeof(set), &set);
+}
+
+static size_t vector_state_size(void)
+{
+	unsigned long vlenb;
+
+	asm volatile (
+		".option push\n\t"
+		".option arch, +v\n\t"
+		"csrr %0, vlenb\n\t"
+		".option pop\n\t"
+		: "=r" (vlenb));
+	return vlenb * 32;
+}
+
+static bool vector_busy_roundtrip(const uint8_t *input, uint8_t *output,
+				  unsigned long loops)
+{
+	unsigned long expected_vl, expected_vtype;
+	unsigned long actual_vl, actual_vtype, actual_vstart, actual_vcsr;
+	unsigned long avl;
+	unsigned long vl;
+	const uint8_t *src_tmp;
+	uint8_t *dst_tmp;
+
+	asm volatile (
+		".option push\n\t"
+		".option arch, +v\n\t"
+		"vsetvli %[vl], x0, e8, m8, ta, ma\n\t"
+		"mv %[src_tmp], %[input]\n\t"
+		"vle8.v v0, (%[src_tmp])\n\t"
+		"add %[src_tmp], %[src_tmp], %[vl]\n\t"
+		"vle8.v v8, (%[src_tmp])\n\t"
+		"add %[src_tmp], %[src_tmp], %[vl]\n\t"
+		"vle8.v v16, (%[src_tmp])\n\t"
+		"add %[src_tmp], %[src_tmp], %[vl]\n\t"
+		"vle8.v v24, (%[src_tmp])\n\t"
+		"li %[avl], 7\n\t"
+		"vsetvli %[expected_vl], %[avl], e16, m4, tu, mu\n\t"
+		"csrr %[expected_vtype], vtype\n\t"
+		"csrwi vcsr, 3\n\t"
+		"csrwi vstart, 2\n\t"
+		"1:\n\t"
+		"addi %[loops], %[loops], -1\n\t"
+		"bnez %[loops], 1b\n\t"
+		"csrr %[actual_vl], vl\n\t"
+		"csrr %[actual_vtype], vtype\n\t"
+		"csrr %[actual_vstart], vstart\n\t"
+		"csrr %[actual_vcsr], vcsr\n\t"
+		"vsetvli %[vl], x0, e8, m8, ta, ma\n\t"
+		"mv %[dst_tmp], %[output]\n\t"
+		"vse8.v v0, (%[dst_tmp])\n\t"
+		"add %[dst_tmp], %[dst_tmp], %[vl]\n\t"
+		"vse8.v v8, (%[dst_tmp])\n\t"
+		"add %[dst_tmp], %[dst_tmp], %[vl]\n\t"
+		"vse8.v v16, (%[dst_tmp])\n\t"
+		"add %[dst_tmp], %[dst_tmp], %[vl]\n\t"
+		"vse8.v v24, (%[dst_tmp])\n\t"
+		".option pop\n\t"
+		: [vl] "=&r" (vl), [src_tmp] "=&r" (src_tmp),
+		  [dst_tmp] "=&r" (dst_tmp), [avl] "=&r" (avl),
+		  [expected_vl] "=&r" (expected_vl),
+		  [expected_vtype] "=&r" (expected_vtype),
+		  [actual_vl] "=&r" (actual_vl),
+		  [actual_vtype] "=&r" (actual_vtype),
+		  [actual_vstart] "=&r" (actual_vstart),
+		  [actual_vcsr] "=&r" (actual_vcsr), [loops] "+r" (loops)
+		: [input] "r" (input), [output] "r" (output)
+		: "memory");
+
+	return actual_vl == expected_vl &&
+	       actual_vtype == expected_vtype && actual_vstart == 2 &&
+	       actual_vcsr == 3;
+}
+
+static void fill_pattern(uint8_t *buffer, size_t size, uint8_t seed,
+			 unsigned int round)
+{
+	size_t i;
+
+	for (i = 0; i < size; i++)
+		buffer[i] = seed ^ (uint8_t)i ^ (uint8_t)(round * 17);
+}
+
+static void *vector_worker(void *opaque)
+{
+	struct vector_worker_args *args = opaque;
+	uint8_t *input = NULL;
+	uint8_t *output = NULL;
+	size_t size = vector_state_size();
+	unsigned int round;
+	bool ready = true;
+
+	if (pin_current_thread(args->cpu)) {
+		atomic_fetch_add(args->failures, 1);
+		ready = false;
+	}
+	if (ready && (posix_memalign((void **)&input, 64, size) ||
+	    posix_memalign((void **)&output, 64, size))) {
+		atomic_fetch_add(args->failures, 1);
+		ready = false;
+	}
+
+	pthread_barrier_wait(args->barrier);
+	if (!ready)
+		goto out;
+	for (round = 0; round < args->rounds; round++) {
+		fill_pattern(input, size, args->seed, round);
+		memset(output, 0, size);
+		if (!vector_busy_roundtrip(input, output, args->loops) ||
+		    memcmp(input, output, size)) {
+			atomic_fetch_add(args->failures, 1);
+			break;
+		}
+	}
+
+out:
+	free(output);
+	free(input);
+	return NULL;
+}
+
+static void *usercopy_noise_worker(void *opaque)
+{
+	struct noise_worker_args *args = opaque;
+	uint8_t buffer[4096];
+	int fd = -1;
+	bool ready = true;
+
+	if (pin_current_thread(args->cpu))
+		ready = false;
+	if (ready) {
+		fd = open("/dev/zero", O_RDONLY);
+		if (fd < 0)
+			ready = false;
+	}
+	if (!ready)
+		atomic_fetch_add(args->failures, 1);
+
+	pthread_barrier_wait(args->barrier);
+	if (!ready)
+		return NULL;
+	while (!atomic_load_explicit(args->stop, memory_order_relaxed)) {
+		if (read(fd, buffer, sizeof(buffer)) != (ssize_t)sizeof(buffer))
+			break;
+	}
+	close(fd);
+	return NULL;
+}
+
+static bool run_nonvector_noise_test(void)
+{
+	pthread_barrier_t barrier;
+	atomic_int failures = 0;
+	atomic_bool stop = false;
+	struct vector_worker_args vector_args = {
+		.cpu = 0,
+		.seed = 0x31,
+		.rounds = VECTOR_ROUNDS,
+		.loops = BUSY_LOOPS,
+		.barrier = &barrier,
+		.failures = &failures,
+	};
+	struct noise_worker_args noise_args = {
+		.cpu = 0,
+		.barrier = &barrier,
+		.stop = &stop,
+		.failures = &failures,
+	};
+	pthread_t vector_thread;
+	pthread_t noise_thread;
+
+	pthread_barrier_init(&barrier, NULL, 2);
+	if (pthread_create(&vector_thread, NULL, vector_worker, &vector_args) ||
+	    pthread_create(&noise_thread, NULL, usercopy_noise_worker, &noise_args))
+		return false;
+	pthread_join(vector_thread, NULL);
+	atomic_store(&stop, true);
+	pthread_join(noise_thread, NULL);
+	pthread_barrier_destroy(&barrier);
+	return atomic_load(&failures) == 0;
+}
+
+static bool run_two_vector_test(void)
+{
+	pthread_barrier_t barrier;
+	atomic_int failures = 0;
+	struct vector_worker_args args[2] = {
+		{
+			.cpu = 0,
+			.seed = 0x55,
+			.rounds = VECTOR_ROUNDS,
+			.loops = BUSY_LOOPS,
+			.barrier = &barrier,
+			.failures = &failures,
+		},
+		{
+			.cpu = 0,
+			.seed = 0xaa,
+			.rounds = VECTOR_ROUNDS,
+			.loops = BUSY_LOOPS,
+			.barrier = &barrier,
+			.failures = &failures,
+		},
+	};
+	pthread_t threads[2];
+
+	pthread_barrier_init(&barrier, NULL, 2);
+	if (pthread_create(&threads[0], NULL, vector_worker, &args[0]) ||
+	    pthread_create(&threads[1], NULL, vector_worker, &args[1]))
+		return false;
+	pthread_join(threads[0], NULL);
+	pthread_join(threads[1], NULL);
+	pthread_barrier_destroy(&barrier);
+	return atomic_load(&failures) == 0;
+}
+
+static void signal_handler(int signo)
+{
+	(void)signo;
+	signal_seen = 1;
+}
+
+static bool run_migration_signal_test(void)
+{
+	pthread_barrier_t barrier;
+	atomic_int failures = 0;
+	struct vector_worker_args args = {
+		.cpu = 0,
+		.seed = 0xc3,
+		.rounds = 1,
+		.loops = MIGRATION_LOOPS,
+		.barrier = &barrier,
+		.failures = &failures,
+	};
+	struct sigaction action = {
+		.sa_handler = signal_handler,
+	};
+	cpu_set_t set;
+	pthread_t thread;
+
+	if (sysconf(_SC_NPROCESSORS_ONLN) < 2)
+		return true;
+
+	sigemptyset(&action.sa_mask);
+	sigaction(SIGUSR1, &action, NULL);
+	signal_seen = 0;
+	pthread_barrier_init(&barrier, NULL, 2);
+	if (pthread_create(&thread, NULL, vector_worker, &args))
+		return false;
+	pthread_barrier_wait(&barrier);
+	usleep(10000);
+	CPU_ZERO(&set);
+	CPU_SET(1, &set);
+	if (pthread_setaffinity_np(thread, sizeof(set), &set))
+		atomic_fetch_add(&failures, 1);
+	usleep(10000);
+	if (pthread_kill(thread, SIGUSR1))
+		atomic_fetch_add(&failures, 1);
+	pthread_join(thread, NULL);
+	pthread_barrier_destroy(&barrier);
+	return atomic_load(&failures) == 0 && signal_seen;
+}
