index 247c53645..0ef8b28cf 100644
--- a/arch/riscv/Kconfig
+++ b/arch/riscv/Kconfig
@@ -569,6 +569,19 @@ config RISCV_ISA_V_PREEMPTIVE
 	  preemption. Enabling this config will result in higher memory
 	  consumption due to the allocation of per-task's kernel Vector context.
 
+config RISCV_ISA_V_USER_OWNER
+	bool "Cache userspace Vector register ownership per CPU"
+	depends on RISCV_ISA_V
+	default n
+	help
+	  Track which userspace task owns the Vector registers resident on each
+	  CPU. With riscv_v_user_owner=restore, returning to the same task on the
+	  same CPU can skip an otherwise redundant Vector restore. Dirty Vector
+	  state is still saved eagerly on switch-out, so memory always contains a
+	  valid fallback copy.
+
+	  The feature is disabled unless enabled with the kernel command line.
+
