diff --git a/arch/riscv/kernel/vector_user_owner.c b/arch/riscv/kernel/vector_user_owner.c
new file mode 100644
index 000000000..a9d10f195
--- /dev/null
+++ b/arch/riscv/kernel/vector_user_owner.c
@@ -0,0 +1,290 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/atomic.h>
+#include <linux/cpuhotplug.h>
+#include <linux/cpu.h>
+#include <linux/debugfs.h>
+#include <linux/export.h>
+#include <linux/init.h>
+#include <linux/percpu.h>
+#include <linux/preempt.h>
+#include <linux/sched.h>
+#include <linux/seq_file.h>
+#include <linux/string.h>
+
+#include <asm/processor.h>
+#include <asm/vector.h>
+#include <asm/vector_user_owner.h>
+
+enum riscv_v_user_owner_mode {
+	RISCV_V_USER_OWNER_OFF,
+	RISCV_V_USER_OWNER_RESTORE,
+};
+
+struct riscv_v_user_owner_cpu {
+	u64 cookie;
+	u64 sequence;
+	pid_t pid;
+	u64 saves;
+	u64 restores;
+	u64 restore_elided;
+	u64 owner_hits;
+	u64 miss_empty;
+	u64 miss_other_task;
+	u64 miss_state;
+	u64 miss_cpu;
+	u64 invalid_kernel;
+	u64 invalid_kvm;
+	u64 invalid_cpu_pm;
+	u64 state_signal;
+	u64 state_ptrace;
+	u64 state_exec;
+};
+
+static DEFINE_PER_CPU(struct riscv_v_user_owner_cpu, riscv_v_user_owner_cpus);
+static atomic64_t riscv_v_user_owner_cookie = ATOMIC64_INIT(0);
+static enum riscv_v_user_owner_mode riscv_v_user_owner_mode __ro_after_init;
+
+static int __init riscv_v_user_owner_setup(char *str)
+{
+	if (!str || !strcmp(str, "off")) {
+		riscv_v_user_owner_mode = RISCV_V_USER_OWNER_OFF;
+		return 0;
+	}
+
+	if (!strcmp(str, "restore")) {
+		riscv_v_user_owner_mode = RISCV_V_USER_OWNER_RESTORE;
+		return 0;
+	}
+
+	pr_warn("riscv_v_user_owner: unknown mode '%s', using off\n", str);
+	riscv_v_user_owner_mode = RISCV_V_USER_OWNER_OFF;
+	return 0;
+}
+early_param("riscv_v_user_owner", riscv_v_user_owner_setup);
+
+bool riscv_v_user_owner_enabled(void)
+{
+	return READ_ONCE(riscv_v_user_owner_mode) ==
+	       RISCV_V_USER_OWNER_RESTORE;
+}
+
+static struct riscv_v_user_owner_cpu *riscv_v_user_owner_this_cpu(void)
+{
+	return this_cpu_ptr(&riscv_v_user_owner_cpus);
+}
+
+static void riscv_v_user_owner_clear(struct riscv_v_user_owner_cpu *owner)
+{
+	owner->cookie = 0;
+	owner->sequence = 0;
+	owner->pid = 0;
+}
+
+void riscv_v_user_owner_task_init(struct task_struct *task)
+{
+	u64 cookie = atomic64_inc_return(&riscv_v_user_owner_cookie);
+
+	WRITE_ONCE(task->thread.vstate_owner_cookie, cookie);
+	WRITE_ONCE(task->thread.vstate_owner_sequence, 0);
+	WRITE_ONCE(task->thread.vstate_owner_cpu, -1);
+}
+
+static u64 riscv_v_user_owner_ensure_cookie(struct task_struct *task)
+{
+	u64 cookie = READ_ONCE(task->thread.vstate_owner_cookie);
+
+	if (likely(cookie))
+		return cookie;
+
+	cookie = atomic64_inc_return(&riscv_v_user_owner_cookie);
+	WRITE_ONCE(task->thread.vstate_owner_cookie, cookie);
+	return cookie;
+}
+
+void riscv_v_user_owner_note_save(void)
+{
+	struct riscv_v_user_owner_cpu *owner = riscv_v_user_owner_this_cpu();
+
+	owner->saves++;
+}
+
+void riscv_v_user_owner_note_restore(struct task_struct *task)
+{
+	struct riscv_v_user_owner_cpu *owner = riscv_v_user_owner_this_cpu();
+	u64 sequence;
+	u64 cookie;
+
+	owner->restores++;
+	if (!riscv_v_user_owner_enabled())
+		return;
+
+	cookie = riscv_v_user_owner_ensure_cookie(task);
+	sequence = READ_ONCE(task->thread.vstate_owner_sequence) + 1;
+	WRITE_ONCE(task->thread.vstate_owner_sequence, sequence);
+	WRITE_ONCE(task->thread.vstate_owner_cpu, raw_smp_processor_id());
+
+	owner->cookie = cookie;
+	owner->sequence = sequence;
+	owner->pid = task_pid_nr(task);
+}
+
+bool riscv_v_user_owner_try_restore_elide(struct task_struct *task)
+{
+	struct riscv_v_user_owner_cpu *owner;
+	u64 sequence;
+	u64 cookie;
+	int cpu;
+
+	if (!riscv_v_user_owner_enabled())
+		return false;
+	if ((task_pt_regs(task)->status & SR_VS) == SR_VS_OFF)
+		return false;
+
+	owner = riscv_v_user_owner_this_cpu();
+	cookie = READ_ONCE(task->thread.vstate_owner_cookie);
+	sequence = READ_ONCE(task->thread.vstate_owner_sequence);
+	cpu = READ_ONCE(task->thread.vstate_owner_cpu);
+
+	if (!owner->cookie) {
+		owner->miss_empty++;
+		return false;
+	}
+	if (!cookie || owner->cookie != cookie) {
+		owner->miss_other_task++;
+		return false;
+	}
+	if (owner->sequence != sequence) {
+		owner->miss_state++;
+		return false;
+	}
+	if (cpu != raw_smp_processor_id()) {
+		owner->miss_cpu++;
+		return false;
+	}
+
+	owner->owner_hits++;
+	owner->restore_elided++;
+	return true;
+}
+
+void riscv_v_user_owner_invalidate_cpu(
+	enum riscv_v_user_owner_invalidate_reason reason)
+{
+	struct riscv_v_user_owner_cpu *owner;
+
+	if (!riscv_v_user_owner_enabled())
+		return;
+
+	preempt_disable();
+	owner = riscv_v_user_owner_this_cpu();
+	if (owner->cookie) {
+		switch (reason) {
+		case RISCV_V_USER_OWNER_INVALID_KERNEL:
+			owner->invalid_kernel++;
+			break;
+		case RISCV_V_USER_OWNER_INVALID_KVM:
+			owner->invalid_kvm++;
+			break;
+		case RISCV_V_USER_OWNER_INVALID_CPU_PM:
+			owner->invalid_cpu_pm++;
+			break;
+		}
+		riscv_v_user_owner_clear(owner);
+	}
+	preempt_enable();
+}
+EXPORT_SYMBOL_GPL(riscv_v_user_owner_invalidate_cpu);
+
+void riscv_v_user_owner_state_changed(
+	struct task_struct *task,
+	enum riscv_v_user_owner_state_reason reason)
+{
+	struct riscv_v_user_owner_cpu *stats;
+	u64 sequence;
+
+	sequence = READ_ONCE(task->thread.vstate_owner_sequence) + 1;
+	WRITE_ONCE(task->thread.vstate_owner_sequence, sequence);
+	WRITE_ONCE(task->thread.vstate_owner_cpu, -1);
+
+	preempt_disable();
+	stats = riscv_v_user_owner_this_cpu();
+	switch (reason) {
+	case RISCV_V_USER_OWNER_STATE_SIGNAL:
+		stats->state_signal++;
+		break;
+	case RISCV_V_USER_OWNER_STATE_PTRACE:
+		stats->state_ptrace++;
+		break;
+	case RISCV_V_USER_OWNER_STATE_EXEC:
+		stats->state_exec++;
+		break;
+	}
+	preempt_enable();
+}
+
+static int riscv_v_user_owner_cpu_online(unsigned int cpu)
+{
+	struct riscv_v_user_owner_cpu *owner;
+
+	owner = per_cpu_ptr(&riscv_v_user_owner_cpus, cpu);
+	riscv_v_user_owner_clear(owner);
+	return 0;
+}
+
+static int riscv_v_user_owner_cpu_offline(unsigned int cpu)
+{
+	struct riscv_v_user_owner_cpu *owner;
+
+	owner = per_cpu_ptr(&riscv_v_user_owner_cpus, cpu);
+	if (owner->cookie)
+		owner->invalid_cpu_pm++;
+	riscv_v_user_owner_clear(owner);
+	return 0;
+}
+
+static int riscv_v_user_owner_stats_show(struct seq_file *m, void *unused)
+{
+	unsigned int cpu;
+
+	seq_printf(m, "mode=%s\n",
+		   riscv_v_user_owner_enabled() ? "restore" : "off");
+	seq_puts(m, "cpu owner_pid cookie sequence saves restores elided hits ");
+	seq_puts(m, "miss_empty miss_other miss_state miss_cpu invalid_kernel ");
+	seq_puts(m, "invalid_kvm invalid_cpu_pm state_signal state_ptrace state_exec\n");
+
+	for_each_possible_cpu(cpu) {
+		struct riscv_v_user_owner_cpu *s;
+
+		s = per_cpu_ptr(&riscv_v_user_owner_cpus, cpu);
+		seq_printf(m,
+			   "%u %d %llu %llu %llu %llu %llu %llu %llu %llu %llu %llu %llu %llu %llu %llu %llu %llu\n",
+			   cpu, s->pid, s->cookie, s->sequence, s->saves,
+			   s->restores, s->restore_elided, s->owner_hits,
+			   s->miss_empty, s->miss_other_task, s->miss_state,
+			   s->miss_cpu, s->invalid_kernel, s->invalid_kvm,
+			   s->invalid_cpu_pm, s->state_signal,
+			   s->state_ptrace, s->state_exec);
+	}
+	return 0;
+}
+
+DEFINE_SHOW_ATTRIBUTE(riscv_v_user_owner_stats);
+
+static int __init riscv_v_user_owner_init(void)
+{
+	int ret;
+
+	ret = cpuhp_setup_state_nocalls(CPUHP_AP_ONLINE_DYN,
+					"riscv/vector_user_owner:online",
+					riscv_v_user_owner_cpu_online,
+					riscv_v_user_owner_cpu_offline);
+	if (ret < 0)
+		pr_warn("riscv_v_user_owner: CPU hotplug setup failed: %d\n", ret);
+
+	debugfs_create_file("riscv_v_user_owner_stats", 0444, NULL, NULL,
+			    &riscv_v_user_owner_stats_fops);
+	pr_info("riscv_v_user_owner: mode=%s\n",
+		riscv_v_user_owner_enabled() ? "restore" : "off");
+	return 0;
+}
+arch_initcall(riscv_v_user_owner_init);
