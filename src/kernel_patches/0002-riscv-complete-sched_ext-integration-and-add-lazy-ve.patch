+	ksft_set_plan(3);
+
+	ok = run_nonvector_noise_test();
+	ksft_test_result(ok, "vector owner survives non-vector and kernel usercopy noise\n");
+	ok = run_two_vector_test();
+	ksft_test_result(ok, "two vector tasks sharing one CPU preserve independent state\n");
+	ok = run_migration_signal_test();
+	ksft_test_result(ok, "vector state survives migration and signal delivery\n");
+
+	ksft_finished();
+}
