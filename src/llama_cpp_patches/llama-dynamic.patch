+#ifndef DT_CLIENT_H
+#define DT_CLIENT_H
+#include "dynamic-control.h"
+#include <stdbool.h>
+
+struct dt_client {
+    int fd, timeout_ms;
+    uint32_t slot;
+    unsigned lifetime, maximum;
+    unsigned allocation, phase, prompt_tokens, decode_tokens;
+    bool held, revoked, pending, active;
+    uint64_t session, request, epoch;
