+    uint64_t barrier_hint_epoch;
+#endif
 };
 
 // Helpers for polling loops
@@ -570,7 +586,35 @@ void ggml_barrier(struct ggml_threadpool * tp) {
     }
 
 #ifdef GGML_USE_OPENMP
+#if defined(__gnu_linux__)
+    struct ggml_compute_state * hint_worker = NULL;
+    if (tp->barrier_hint_graph_epoch) {
+        const int ith = omp_get_thread_num();
+        hint_worker = &tp->workers[ith];
+        hint_worker->barrier_hint_epoch++;
+        ggml_scx_barrier_hint_update(
+                hint_worker->barrier_hint_tid,
+                ith,
+                n_threads,
+                BARRIER_GANG_PHASE_WAITING,
+                tp->barrier_hint_graph_epoch,
+                hint_worker->barrier_hint_epoch,
+                hint_worker->barrier_hint_node_index);
+    }
+#endif
     #pragma omp barrier
+#if defined(__gnu_linux__)
+    if (hint_worker != NULL) {
+        ggml_scx_barrier_hint_update(
+                hint_worker->barrier_hint_tid,
+                hint_worker->ith,
+                n_threads,
+                BARRIER_GANG_PHASE_COMPUTE,
+                tp->barrier_hint_graph_epoch,
+                hint_worker->barrier_hint_epoch,
+                hint_worker->barrier_hint_node_index);
+    }
+#endif
 #else
     int n_passed = atomic_load_explicit(&tp->n_barrier_passed, memory_order_relaxed);
 
@@ -3050,6 +3094,10 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
             continue;
         }
 
+#if defined(GGML_USE_OPENMP) && defined(__gnu_linux__)
+        state->barrier_hint_node_index = (uint32_t) node_n;
+#endif
+
         // TODO: move fused-op detection into ggml_graph_plan so fusion decisions are made once at planning time
         // Try fused ops, fall back to normal compute
         const int n_fused = ggml_cpu_try_fuse_ops(cgraph, node_n, &params, cplan);
@@ -3076,6 +3124,9 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
     GGML_PRINT_DEBUG("thread #%d compute-done cplan %p last-graph %d\n", state->ith, (const void *)cplan, state->last_graph);
 #endif
 
+#if defined(GGML_USE_OPENMP) && defined(__gnu_linux__)
+    state->barrier_hint_node_index = (uint32_t) cgraph->n_nodes;
+#endif
     ggml_barrier(state->threadpool);
 
 #ifdef GGML_USE_CPU_RISCV64_SPACEMIT
@@ -3329,6 +3380,11 @@ enum ggml_status ggml_graph_compute(struct ggml_cgraph * cgraph, struct ggml_cpl
     }
 
 #ifdef GGML_USE_OPENMP
+#if defined(__gnu_linux__)
+    ggml_scx_lease_hint_graph_begin(n_threads);
+    threadpool->barrier_hint_graph_epoch =
+            ggml_scx_barrier_hint_graph_begin(n_threads);
+#endif
     if (n_threads > 1) {
         #pragma omp parallel num_threads(n_threads)
         {
@@ -3342,16 +3398,50 @@ enum ggml_status ggml_graph_compute(struct ggml_cgraph * cgraph, struct ggml_cpl
             // Apply thread CPU mask and priority
             int ith = omp_get_thread_num();
 
+#if defined(__gnu_linux__)
+            struct ggml_compute_state * hint_worker = &threadpool->workers[ith];
+            if (!hint_worker->barrier_hint_tid) {
+                hint_worker->barrier_hint_tid = (uint32_t) syscall(SYS_gettid);
+            }
+            ggml_scx_lease_hint_register(
+                    hint_worker->barrier_hint_tid,
+                    ith,
+                    n_threads);
+            hint_worker->barrier_hint_epoch = 0;
+            hint_worker->barrier_hint_node_index = 0;
+            ggml_scx_barrier_hint_update(
+                    hint_worker->barrier_hint_tid,
+                    ith,
+                    n_threads,
+                    BARRIER_GANG_PHASE_COMPUTE,
+                    threadpool->barrier_hint_graph_epoch,
+                    0,
+                    0);
+#endif
+
             ggml_thread_apply_priority(threadpool->prio);
             if (ggml_thread_cpumask_is_valid(threadpool->workers[ith].cpumask)) {
                 ggml_thread_apply_affinity(threadpool->workers[ith].cpumask);
             }
             ggml_graph_compute_thread(&threadpool->workers[ith]);
+#if defined(__gnu_linux__)
+            ggml_scx_barrier_hint_update(
+                    hint_worker->barrier_hint_tid,
+                    ith,
+                    n_threads,
+                    BARRIER_GANG_PHASE_IDLE,
+                    threadpool->barrier_hint_graph_epoch,
+                    hint_worker->barrier_hint_epoch,
+                    hint_worker->barrier_hint_node_index);
+#endif
         }
     } else {
         atomic_store_explicit(&threadpool->n_graph, 1, memory_order_relaxed);
         ggml_graph_compute_thread(&threadpool->workers[0]);
     }
+#if defined(__gnu_linux__)
+    threadpool->barrier_hint_graph_epoch = 0;
+#endif
 #else
     if (n_threads > threadpool->n_threads) {
         GGML_LOG_WARN("cplan requested more threads (%d) than available (%d)\n", n_threads, threadpool->n_threads);
