diff --git a/ggml/src/ggml-cpu/scx-barrier-hint-client.c b/ggml/src/ggml-cpu/scx-barrier-hint-client.c
new file mode 100644
index 0000000..1802fb0
--- /dev/null
+++ b/ggml/src/ggml-cpu/scx-barrier-hint-client.c
@@ -0,0 +1,463 @@
+// SPDX-License-Identifier: MIT
+#include "scx-barrier-hint-client.h"
+
+#if defined(__linux__) && defined(GGML_USE_OPENMP)
+
+#include "scx-rvv-barrier-hint.h"
+#include "scx-rvv-lease-control.h"
+
+#include <errno.h>
+#include <linux/bpf.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/syscall.h>
+#include <time.h>
+#include <unistd.h>
+
+struct ggml_scx_hint_client {
+    struct barrier_gang_hint_page * page;
+    size_t mapping_size;
+    uint64_t next_graph_epoch;
+    uint64_t retry_after_ns;
+    uint64_t connected_session_id;
+    uint32_t tgid;
+    bool configured;
+    char path[256];
+};
+
+static struct ggml_scx_hint_client g_hint_client;
+
+struct ggml_scx_lease_client {
+    void * mapping;
+    struct rvv_lease_worker_page * page;
+    size_t mapping_size;
+    uint64_t retry_after_ns;
+    uint64_t connected_session_id;
+    uint64_t next_phase_epoch;
+    uint32_t tgid;
+    bool configured;
+    char path[256];
+};
+
+static struct ggml_scx_lease_client g_lease_client;
+
+static uint64_t monotonic_ns(void) {
+    struct timespec ts;
+
+    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) {
+        return 0;
+    }
+    return (uint64_t) ts.tv_sec * 1000000000ULL + (uint64_t) ts.tv_nsec;
+}
+
+static int bpf_obj_get_raw(const char * path) {
+    union bpf_attr attr;
+
+    memset(&attr, 0, sizeof(attr));
+    attr.pathname = (uint64_t) (uintptr_t) path;
+    return (int) syscall(__NR_bpf, BPF_OBJ_GET, &attr, sizeof(attr));
+}
+
+static int bpf_map_info_raw(int fd, struct bpf_map_info * info) {
+    union bpf_attr attr;
+    uint32_t length = sizeof(*info);
+
+    memset(info, 0, sizeof(*info));
+    memset(&attr, 0, sizeof(attr));
+    attr.info.bpf_fd = (uint32_t) fd;
+    attr.info.info_len = length;
+    attr.info.info = (uint64_t) (uintptr_t) info;
+    return (int) syscall(__NR_bpf, BPF_OBJ_GET_INFO_BY_FD, &attr, sizeof(attr));
+}
+
+static void disconnect_hint_map(void) {
+    if (g_hint_client.page != NULL) {
+        munmap(g_hint_client.page, g_hint_client.mapping_size);
+    }
+    g_hint_client.page = NULL;
+    g_hint_client.mapping_size = 0;
+}
+
+static void configure_hint_path(void) {
+    const char * path;
+
+    if (g_hint_client.configured) {
+        return;
+    }
+    g_hint_client.configured = true;
+    path = getenv("GGML_SCX_GANG_HINT_PATH");
+    if (path == NULL || path[0] == '\0') {
+        return;
+    }
+    snprintf(g_hint_client.path, sizeof(g_hint_client.path), "%s", path);
+}
+
+static bool connect_hint_map(void) {
+    struct bpf_map_info info;
+    struct barrier_gang_hint_page * page;
+    long page_size;
+    size_t mapping_size;
+    uint64_t now;
+    int fd;
+
+    configure_hint_path();
+    if (g_hint_client.path[0] == '\0') {
+        return false;
+    }
+    if (g_hint_client.page != NULL) {
+        if (__atomic_load_n(&g_hint_client.page->header.active, __ATOMIC_ACQUIRE) &&
+                g_hint_client.page->header.target_tgid == g_hint_client.tgid) {
+            return true;
+        }
+        disconnect_hint_map();
+    }
+
+    now = monotonic_ns();
+    if (now && now < g_hint_client.retry_after_ns) {
+        return false;
+    }
+    g_hint_client.retry_after_ns = now + 1000000000ULL;
+    if (!g_hint_client.tgid) {
+        g_hint_client.tgid = (uint32_t) getpid();
+    }
+    fd = bpf_obj_get_raw(g_hint_client.path);
+    if (fd < 0) {
+        return false;
+    }
+    if (bpf_map_info_raw(fd, &info) != 0 ||
+            info.type != BPF_MAP_TYPE_ARRAY || info.max_entries != 1 ||
+            info.value_size != sizeof(struct barrier_gang_hint_page) ||
+            !(info.map_flags & BPF_F_MMAPABLE)) {
+        close(fd);
+        return false;
+    }
+    page_size = sysconf(_SC_PAGESIZE);
+    if (page_size <= 0) {
+        close(fd);
+        return false;
+    }
+    mapping_size = (info.value_size + (size_t) page_size - 1) &
+            ~((size_t) page_size - 1);
+    page = mmap(NULL, mapping_size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    close(fd);
+    if (page == MAP_FAILED) {
+        return false;
+    }
+    if (page->header.magic != BARRIER_GANG_HINT_MAGIC ||
+            page->header.abi_version != BARRIER_GANG_HINT_ABI_VERSION ||
+            !page->header.active || page->header.target_tgid != g_hint_client.tgid ||
+            page->header.max_workers < BARRIER_GANG_HINT_POLICY_WORKERS ||
+            !page->header.session_id) {
+        munmap(page, mapping_size);
+        return false;
+    }
+    g_hint_client.page = page;
+    g_hint_client.mapping_size = mapping_size;
+    if (g_hint_client.connected_session_id != page->header.session_id) {
+        fprintf(stderr, "GGML_SCX_GANG_HINT connected path=%s session=%llu\n",
+                g_hint_client.path,
+                (unsigned long long) page->header.session_id);
+        fflush(stderr);
+        g_hint_client.connected_session_id = page->header.session_id;
+    }
+    return true;
+}
+
+static void disconnect_lease_map(void) {
+    if (g_lease_client.mapping != NULL) {
+        munmap(g_lease_client.mapping, g_lease_client.mapping_size);
+    }
+    g_lease_client.mapping = NULL;
+    g_lease_client.page = NULL;
+    g_lease_client.mapping_size = 0;
+}
+
+static void configure_lease_path(void) {
+    const char * path;
+
+    if (g_lease_client.configured) {
+        return;
+    }
+    g_lease_client.configured = true;
+    path = getenv("GGML_SCX_LEASE_HINT_PATH");
+    if (path == NULL || path[0] == '\0') {
+        return;
+    }
+    snprintf(g_lease_client.path, sizeof(g_lease_client.path), "%s", path);
+}
+
+static bool connect_lease_map(void) {
+    struct bpf_map_info info;
+    struct rvv_lease_worker_page * page = NULL;
+    void * mapping;
+    long page_size;
+    size_t mapping_size;
+    uint64_t now;
+    int fd;
+
+    configure_lease_path();
+    if (g_lease_client.path[0] == '\0') {
+        return false;
+    }
+    if (g_lease_client.page != NULL) {
+        if (__atomic_load_n(&g_lease_client.page->header.active, __ATOMIC_ACQUIRE) &&
+                g_lease_client.page->header.target_tgid == g_lease_client.tgid) {
+            return true;
+        }
+        disconnect_lease_map();
+    }
+
+    now = monotonic_ns();
+    if (now && now < g_lease_client.retry_after_ns) {
+        return false;
+    }
+    g_lease_client.retry_after_ns = now + 1000000000ULL;
+    if (!g_lease_client.tgid) {
+        g_lease_client.tgid = (uint32_t) getpid();
+    }
+    fd = bpf_obj_get_raw(g_lease_client.path);
+    if (fd < 0) {
+        return false;
+    }
+    if (bpf_map_info_raw(fd, &info) != 0 ||
+            info.type != BPF_MAP_TYPE_ARRAY || info.max_entries < 1 ||
+            info.max_entries > RVV_LEASE_CONTROL_TEAMS ||
+            info.value_size != sizeof(struct rvv_lease_worker_page) ||
+            !(info.map_flags & BPF_F_MMAPABLE)) {
+        close(fd);
+        return false;
+    }
+    page_size = sysconf(_SC_PAGESIZE);
+    if (page_size <= 0) {
+        close(fd);
+        return false;
+    }
+    mapping_size = ((size_t) info.value_size * info.max_entries +
+            (size_t) page_size - 1) &
+            ~((size_t) page_size - 1);
+    mapping = mmap(NULL, mapping_size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    close(fd);
+    if (mapping == MAP_FAILED) {
+        return false;
+    }
+    for (uint32_t team = 0; team < info.max_entries; team++) {
+        struct rvv_lease_worker_page * candidate =
+                (struct rvv_lease_worker_page *) ((char *) mapping +
+                        (size_t) team * info.value_size);
+
+        if (candidate->header.magic == RVV_LEASE_CONTROL_MAGIC &&
+                candidate->header.abi_version == RVV_LEASE_CONTROL_ABI_VERSION &&
+                __atomic_load_n(&candidate->header.active, __ATOMIC_ACQUIRE) &&
+                candidate->header.team_id == team &&
+                candidate->header.target_tgid == g_lease_client.tgid &&
+                candidate->header.max_workers == RVV_LEASE_CONTROL_WORKERS &&
+                candidate->header.session_id) {
+            page = candidate;
+            break;
+        }
+    }
+    if (page == NULL) {
+        munmap(mapping, mapping_size);
+        return false;
+    }
+    g_lease_client.mapping = mapping;
+    g_lease_client.page = page;
+    g_lease_client.mapping_size = mapping_size;
+    if (g_lease_client.connected_session_id != page->header.session_id) {
+        fprintf(stderr, "GGML_SCX_LEASE_HINT connected path=%s team=%u session=%llu\n",
+                g_lease_client.path,
+                page->header.team_id,
+                (unsigned long long) page->header.session_id);
+        fflush(stderr);
+        g_lease_client.connected_session_id = page->header.session_id;
+    }
+    return true;
+}
+
+void ggml_scx_lease_hint_graph_begin(int n_threads) {
+    if (n_threads == (int) RVV_LEASE_CONTROL_WORKERS) {
+        connect_lease_map();
+    }
+}
+
+void ggml_scx_lease_hint_register(uint32_t tid, int ith, int n_threads) {
+    struct rvv_lease_worker_page * page = g_lease_client.page;
+    struct rvv_lease_worker_slot * slot;
+    uint32_t sequence;
+
+    if (page == NULL || !tid || n_threads != (int) RVV_LEASE_CONTROL_WORKERS ||
+            ith < 0 || ith >= n_threads ||
+            !__atomic_load_n(&page->header.active, __ATOMIC_ACQUIRE)) {
+        return;
+    }
+    slot = &page->workers[ith];
+    sequence = __atomic_load_n(&slot->sequence, __ATOMIC_ACQUIRE);
+    if (!(sequence & 1U) && slot->tid == tid &&
+            slot->tgid == g_lease_client.tgid && slot->ith == (uint32_t) ith &&
+            slot->n_threads == (uint32_t) n_threads &&
+            slot->session_id == page->header.session_id) {
+        return;
+    }
+    if (sequence & 1U) {
+        sequence++;
+    }
+    __atomic_store_n(&slot->sequence, sequence + 1, __ATOMIC_RELAXED);
+    __atomic_thread_fence(__ATOMIC_RELEASE);
+    slot->tid = tid;
+    slot->tgid = g_lease_client.tgid;
+    slot->ith = (uint32_t) ith;
+    slot->n_threads = (uint32_t) n_threads;
+    slot->flags = 0;
+    slot->session_id = page->header.session_id;
+    __atomic_store_n(&slot->sequence, sequence + 2, __ATOMIC_RELEASE);
+}
+
+static void publish_lease_phase(
+        uint32_t phase,
+        uint32_t prompt_tokens,
+        uint32_t decode_tokens,
+        uint32_t active_workers) {
+    struct rvv_lease_worker_page * page = g_lease_client.page;
+    struct rvv_lease_team_hint * hint;
+    uint32_t sequence;
+    uint64_t now;
+
+    if (page == NULL || phase > RVV_LEASE_PHASE_MIXED ||
+            !__atomic_load_n(&page->header.active, __ATOMIC_ACQUIRE)) {
+        return;
+    }
+    hint = &page->team_hint;
+    sequence = __atomic_load_n(&hint->sequence, __ATOMIC_RELAXED);
+    if (sequence & 1U) {
+        sequence++;
+    }
+    now = monotonic_ns();
+    __atomic_store_n(&hint->sequence, sequence + 1, __ATOMIC_RELAXED);
+    __atomic_thread_fence(__ATOMIC_RELEASE);
+    hint->phase = phase;
+    hint->active_workers = active_workers;
+    hint->flags = phase == RVV_LEASE_PHASE_PREFILL || phase == RVV_LEASE_PHASE_MIXED ?
+            RVV_LEASE_MODEL_LATENCY_SENSITIVE : 0;
+    hint->prompt_tokens = prompt_tokens;
+    hint->decode_tokens = decode_tokens;
+    hint->phase_epoch = __atomic_add_fetch(
+            &g_lease_client.next_phase_epoch, 1, __ATOMIC_RELAXED);
+    hint->begin_ns = now;
+    hint->expires_ns = phase == RVV_LEASE_PHASE_IDLE || !now ? 0 :
+            now + 300000000000ULL;
+    hint->session_id = page->header.session_id;
+    __atomic_store_n(&hint->sequence, sequence + 2, __ATOMIC_RELEASE);
+}
+
+void ggml_scx_lease_hint_phase_begin(
+        uint32_t phase,
+        uint32_t prompt_tokens,
+        uint32_t decode_tokens,
+        uint32_t active_workers) {
+    if (!connect_lease_map()) {
+        return;
+    }
+    publish_lease_phase(
+            phase, prompt_tokens, decode_tokens, active_workers);
+}
+
+void ggml_scx_lease_hint_phase_end(void) {
+    publish_lease_phase(RVV_LEASE_PHASE_IDLE, 0, 0, 0);
+}
+
+uint64_t ggml_scx_barrier_hint_graph_begin(int n_threads) {
+    if (n_threads != (int) BARRIER_GANG_HINT_POLICY_WORKERS ||
+            !connect_hint_map()) {
+        return 0;
+    }
+    return __atomic_add_fetch(&g_hint_client.next_graph_epoch, 1, __ATOMIC_RELAXED);
+}
+
+void ggml_scx_barrier_hint_update(
+        uint32_t tid,
+        int ith,
+        int n_threads,
+        uint32_t phase,
+        uint64_t graph_epoch,
+        uint64_t barrier_epoch,
+        uint32_t node_index) {
+    struct barrier_gang_hint_page * page = g_hint_client.page;
+    struct barrier_gang_hint_slot * slot;
+    uint32_t sequence;
+
+    if (page == NULL || !graph_epoch || !tid || ith < 0 ||
+            ith >= n_threads || n_threads > (int) BARRIER_GANG_HINT_POLICY_WORKERS ||
+            !__atomic_load_n(&page->header.active, __ATOMIC_ACQUIRE)) {
+        return;
+    }
+    slot = &page->workers[ith];
+    sequence = __atomic_load_n(&slot->sequence, __ATOMIC_RELAXED);
+    if (sequence & 1U) {
+        sequence++;
+    }
+    __atomic_store_n(&slot->sequence, sequence + 1, __ATOMIC_RELAXED);
+    __atomic_thread_fence(__ATOMIC_RELEASE);
+    slot->tid = tid;
+    slot->tgid = g_hint_client.tgid;
+    slot->ith = (uint32_t) ith;
+    slot->n_threads = (uint32_t) n_threads;
+    slot->phase = phase;
+    slot->node_index = node_index;
+    slot->graph_epoch = graph_epoch;
+    slot->barrier_epoch = barrier_epoch;
+    slot->session_id = page->header.session_id;
+    __atomic_store_n(&slot->sequence, sequence + 2, __ATOMIC_RELEASE);
+}
+
+#else
+
+void ggml_scx_lease_hint_graph_begin(int n_threads) {
+    (void) n_threads;
+}
+
+void ggml_scx_lease_hint_register(uint32_t tid, int ith, int n_threads) {
+    (void) tid;
+    (void) ith;
+    (void) n_threads;
+}
+
+void ggml_scx_lease_hint_phase_begin(
+        uint32_t phase,
+        uint32_t prompt_tokens,
+        uint32_t decode_tokens,
+        uint32_t active_workers) {
+    (void) phase;
+    (void) prompt_tokens;
+    (void) decode_tokens;
+    (void) active_workers;
+}
+
+void ggml_scx_lease_hint_phase_end(void) {
+}
+
+uint64_t ggml_scx_barrier_hint_graph_begin(int n_threads) {
+    (void) n_threads;
+    return 0;
+}
+
+void ggml_scx_barrier_hint_update(
+        uint32_t tid,
+        int ith,
+        int n_threads,
+        uint32_t phase,
+        uint64_t graph_epoch,
+        uint64_t barrier_epoch,
+        uint32_t node_index) {
+    (void) tid;
+    (void) ith;
+    (void) n_threads;
+    (void) phase;
+    (void) graph_epoch;
+    (void) barrier_epoch;
+    (void) node_index;
+}
+
+#endif
