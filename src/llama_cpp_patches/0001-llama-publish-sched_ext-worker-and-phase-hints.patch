diff --git a/ggml/src/ggml-cpu/scx-rvv-barrier-hint.h b/ggml/src/ggml-cpu/scx-rvv-barrier-hint.h
new file mode 100644
index 0000000..af8e071
--- /dev/null
+++ b/ggml/src/ggml-cpu/scx-rvv-barrier-hint.h
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: GPL-2.0 OR MIT
+#ifndef __SCX_RVV_BARRIER_HINT_H
+#define __SCX_RVV_BARRIER_HINT_H
+
+#include <linux/types.h>
+
+#define BARRIER_GANG_HINT_MAGIC          0x42474854U
+#define BARRIER_GANG_HINT_ABI_VERSION    1U
+#define BARRIER_GANG_HINT_MAX_WORKERS    16U
+#define BARRIER_GANG_HINT_POLICY_WORKERS 8U
+#define BARRIER_GANG_HINT_DEFAULT_PATH   "/sys/fs/bpf/scx_rvv_barrier_gang/hints"
+
+enum barrier_gang_hint_mode {
+    BARRIER_GANG_HINT_OFF = 0,
+    BARRIER_GANG_HINT_OBSERVE = 1,
+    BARRIER_GANG_HINT_ACTIVE = 2,
+};
+
+enum barrier_gang_hint_phase {
+    BARRIER_GANG_PHASE_UNUSED = 0,
+    BARRIER_GANG_PHASE_IDLE = 1,
+    BARRIER_GANG_PHASE_COMPUTE = 2,
+    BARRIER_GANG_PHASE_WAITING = 3,
+};
+
+struct barrier_gang_hint_header {
+    __u32 magic;
+    __u32 abi_version;
+    __u32 active;
+    __u32 target_tgid;
+    __u32 max_workers;
+    __u32 loader_pid;
+    __u32 reserved32[2];
+    __u64 session_id;
+    __u64 reserved64[3];
+} __attribute__((aligned(64)));
+
+struct barrier_gang_hint_slot {
+    __u32 sequence;
+    __u32 tid;
+    __u32 tgid;
+    __u32 ith;
+    __u32 n_threads;
+    __u32 phase;
+    __u32 node_index;
+    __u32 reserved32;
+    __u64 graph_epoch;
+    __u64 barrier_epoch;
+    __u64 session_id;
+    __u64 reserved64;
+} __attribute__((aligned(64)));
+
+struct barrier_gang_hint_page {
+    struct barrier_gang_hint_header header;
+    struct barrier_gang_hint_slot workers[BARRIER_GANG_HINT_MAX_WORKERS];
+};
+
+_Static_assert(sizeof(struct barrier_gang_hint_header) == 64,
+        "barrier gang hint header must occupy one cache line");
+_Static_assert(sizeof(struct barrier_gang_hint_slot) == 64,
+        "barrier gang worker slot must occupy one cache line");
+_Static_assert(sizeof(struct barrier_gang_hint_page) <= 4096,
+        "barrier gang hint page must fit in one page");
+
+#endif /* __SCX_RVV_BARRIER_HINT_H */
