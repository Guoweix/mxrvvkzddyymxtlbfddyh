From 258b608123e7489d1dde2a2d56f5a7800e16f2bd Mon Sep 17 00:00:00 2001
From: Build <build@local>
Date: Mon, 20 Jul 2026 15:58:17 +0800
Subject: [PATCH] llama: publish sched_ext worker and phase hints

Add optional mmap clients for OpenMP worker/barrier state and the RVV dirty-lease control ABI. Expose one-shot prefill, decode, and mixed phase hints through llama_context, classify server batches, and forward each graph phase to the CPU backend. Missing or incompatible BPF maps remain a no-op.
---
 ggml/src/ggml-cpu/CMakeLists.txt            |   4 +
 ggml/src/ggml-cpu/ggml-cpu.c                |  90 ++++
 ggml/src/ggml-cpu/ggml-cpu.cpp              |  32 +-
 ggml/src/ggml-cpu/scx-barrier-hint-client.c | 463 ++++++++++++++++++++
 ggml/src/ggml-cpu/scx-barrier-hint-client.h |  45 ++
 ggml/src/ggml-cpu/scx-rvv-barrier-hint.h    |  65 +++
 ggml/src/ggml-cpu/scx-rvv-lease-control.h   |  98 +++++
 include/llama.h                             |  21 +
 src/llama-context.cpp                       |  55 ++-
 src/llama-context.h                         |  16 +-
 tools/server/server-context.cpp             |  13 +
 11 files changed, 897 insertions(+), 5 deletions(-)
 create mode 100644 ggml/src/ggml-cpu/scx-barrier-hint-client.c
 create mode 100644 ggml/src/ggml-cpu/scx-barrier-hint-client.h
 create mode 100644 ggml/src/ggml-cpu/scx-rvv-barrier-hint.h
 create mode 100644 ggml/src/ggml-cpu/scx-rvv-lease-control.h

